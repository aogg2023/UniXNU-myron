diff --git a/osfmk/kern/kern_stackshot.c b/osfmk/kern/kern_stackshot.c
--- a/osfmk/kern/kern_stackshot.c
+++ b/osfmk/kern/kern_stackshot.c
@@ -3444,10 +3444,12 @@
 #if DEBUG || DEVELOPMENT
 		if (current_delta_snapshot_index != num_delta_thread_snapshots) {
-			panic("delta thread snapshot count mismatch while capturing snapshots for task %p. expected %d, found %d", task,
-			    num_delta_thread_snapshots, current_delta_snapshot_index);
+			/* myron: a thread can enter or leave a wait state between the count pass and the fill pass. The development
